.fixture-detail-page {
  padding-top: 22rpx;
}

.detail-loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.scoreboard {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  border: 1rpx solid #E4E2D9;
}

.scoreboard__status {
  display: flex;
  justify-content: center;
}

.scoreboard__main {
  display: grid;
  grid-template-columns: 1fr 170rpx 1fr;
  align-items: center;
  gap: 12rpx;
  margin: 28rpx 0 12rpx;
}

.scoreboard__team {
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.4;
}

.scoreboard__team--away {
  text-align: right;
}

.scoreboard__score {
  color: #0B6B4B;
  font-size: 48rpx;
  text-align: center;
}

.scoreboard__locked {
  margin-top: 12rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #EEECE5;
  color: #C7392F;
  font-size: 21rpx;
  text-align: center;
}

.section-head {
  margin-top: 34rpx;
}

.event-list {
  overflow: hidden;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid #E4E2D9;
}

.event-row {
  display: grid;
  grid-template-columns: 74rpx 18rpx 1fr;
  gap: 12rpx;
  padding: 22rpx 20rpx;
  border-bottom: 1rpx solid #EEECE5;
}

.event-row:last-child {
  border-bottom: 0;
}

.event-row__minute {
  color: #0B6B4B;
  font-size: 24rpx;
  padding-top: 2rpx;
}

.event-row__marker {
  width: 12rpx;
  height: 12rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #B7F34A;
}

.event-row__marker--danger {
  background: #C7392F;
}

.event-row__marker--warning {
  background: #C68A1A;
}

.event-row__marker--primary {
  background: #2463A8;
}

.event-row__headline {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.event-row__team {
  color: #7C8983;
  font-size: 20rpx;
}

.event-row__player {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.event-row__assist,
.event-row__note {
  margin-top: 4rpx;
  color: #5E6B65;
  font-size: 21rpx;
}

.lineup-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.lineup-card {
  min-width: 0;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid #E4E2D9;
}

.lineup-card__title {
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #EEECE5;
  font-size: 24rpx;
  font-weight: 700;
}

.lineup-card__empty {
  padding: 24rpx 0;
  color: #7C8983;
  font-size: 21rpx;
  text-align: center;
}

.lineup-row {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F2F0EA;
}

.lineup-row:last-child {
  border-bottom: 0;
}

.lineup-row__name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 23rpx;
  font-weight: 600;
}

.lineup-row__meta {
  margin-top: 4rpx;
  color: #7C8983;
  font-size: 19rpx;
}


.rating-team-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.rating-team-card { min-width: 0; padding: 20rpx; border-radius: 20rpx; background: #fff; border: 1rpx solid #E4E2D9; }
.rating-team-card__title { padding-bottom: 14rpx; border-bottom: 1rpx solid #EEECE5; font-size: 25rpx; font-weight: 800; }
.rating-team-card__empty { padding: 24rpx 0; color: #7C8983; font-size: 21rpx; text-align: center; }
.rating-player-row { padding: 16rpx 0; border-bottom: 1rpx solid #F2F0EA; }
.rating-player-row:last-child { border-bottom: 0; }
.rating-player-row__main { min-width: 0; }
.rating-player-row__name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 23rpx; font-weight: 700; }
.rating-player-row__stars { margin-top: 6rpx; color: #E5B53F; font-size: 22rpx; letter-spacing: 2rpx; }
.rating-player-row__score { margin-top: 6rpx; color: #0B6B4B; font-size: 22rpx; font-weight: 700; }
.rating-overlay { position: fixed; z-index: 40; inset: 0; display: flex; align-items: flex-end; background: rgba(0,0,0,.46); }
.rating-sheet { width: 100%; max-height: 82vh; padding: 28rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #F4F1E8; box-sizing: border-box; }
.rating-sheet__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.rating-sheet__title { font-size: 34rpx; font-weight: 800; }
.rating-sheet__meta { margin-top: 6rpx; color: #7C8983; font-size: 21rpx; }
.rating-sheet__close { color: #7C8983; font-size: 44rpx; line-height: 1; }
.rating-sheet__scroll { max-height: 68vh; margin-top: 20rpx; }
.rating-sheet__label { margin: 8rpx 0; color: #5E6B65; font-size: 22rpx; }
.rating-sheet__score { margin: 10rpx 0 16rpx; color: #0B6B4B; font-weight: 700; }
.rating-sheet__status { margin-bottom: 12rpx; color: #9C6B16; font-size: 21rpx; }
.rating-sheet__textarea { width: 100%; min-height: 150rpx; padding: 18rpx; border-radius: 14rpx; background: #fff; border: 1rpx solid #E4E2D9; box-sizing: border-box; font-size: 24rpx; }
.rating-sheet__counter { margin: 6rpx 0 18rpx; color: #7C8983; font-size: 20rpx; text-align: right; }
.rating-comments__head { display: flex; justify-content: space-between; margin-top: 28rpx; padding-top: 20rpx; border-top: 1rpx solid #DDD9CE; font-size: 24rpx; font-weight: 700; }
.rating-comments__empty { padding: 28rpx 0; color: #7C8983; font-size: 21rpx; text-align: center; }
.rating-comment { margin-top: 14rpx; padding: 18rpx; border-radius: 16rpx; background: #fff; }
.rating-comment__top { display: flex; justify-content: space-between; color: #5E6B65; font-size: 21rpx; }
.rating-comment__name { font-weight: 700; }
.rating-comment__score { color: #0B6B4B; }
.rating-comment__text { margin: 10rpx 0; font-size: 24rpx; line-height: 1.6; }
.rating-comment__actions { display: flex; justify-content: space-between; color: #7C8983; font-size: 19rpx; }
