<view class="page-shell fixture-detail-page">
  <view wx:if="{{loading}}" class="detail-loading">
    <t-loading theme="circular" size="48rpx" text="加载比赛" />
  </view>

  <view wx:elif="{{error}}" class="surface-card">
    <empty-state title="比赛加载失败" description="{{error}}" action-text="重试" bind:action="retry" />
  </view>

  <block wx:else>
    <app-header
      title="比赛详情"
      subtitle="{{timeLabel}} · {{fixture.venue || '场地待定'}} · 主裁 {{fixture.referee || '待定'}}"
      season-name="MATCH DAY"
    />

    <view class="scoreboard">
      <view class="scoreboard__status">
        <t-tag size="small" variant="light" theme="{{statusTone}}">{{statusLabel}}</t-tag>
      </view>
      <view class="scoreboard__main">
        <view class="scoreboard__team">{{fixture.homeTeam.name}}</view>
        <view class="scoreboard__score numeric">
          <block wx:if="{{fixture.homeScore === null || fixture.awayScore === null}}">VS</block>
          <block wx:else>{{fixture.homeScore}} : {{fixture.awayScore}}</block>
        </view>
        <view class="scoreboard__team scoreboard__team--away">{{fixture.awayTeam.name}}</view>
      </view>
      <view class="scoreboard__locked" wx:if="{{fixture.dataLocked}}">数据已锁定</view>
    </view>

    <view class="section-head">
      <view>
        <view class="section-title">当值主裁评分</view>
        <view class="section-subtitle">仅评分，不提供文字评价</view>
      </view>
    </view>
    <view class="referee-rating-card">
      <view class="referee-rating-card__main">
        <view class="referee-rating-card__name">{{fixture.referee || "主裁待定"}}</view>
        <view class="referee-rating-card__stars">{{refereeStarsText}}</view>
        <view class="referee-rating-card__meta">{{refereeRating && refereeRating.ratingCount ? refereeRating.averageScore + "/10 · " + refereeRating.ratingCount + "人评分" : "暂无评分"}}</view>
      </view>
      <t-button size="small" theme="primary" variant="outline"
        disabled="{{!ratingEnabled || !fixture.referee}}" bind:tap="openRefereeRatingDialog">评分</t-button>
    </view>

    <view class="section-head">
      <view>
        <view class="section-title">球员评分</view>
        <view class="section-subtitle">5 星评分，按 10 分制展示</view>
      </view>
    </view>

    <view wx:if="{{!ratingEnabled}}" class="surface-card rating-closed">
      <empty-state title="评分未开放" description="比赛结束后可为主客队出场球员评分。" />
    </view>
    <view wx:else class="rating-team-grid">
      <view class="rating-team-card">
        <view class="rating-team-card__title">{{fixture.homeTeam.name}}</view>
        <view wx:if="{{homeRatings.length === 0}}" class="rating-team-card__empty">暂无出场球员</view>
        <view wx:for="{{homeRatings}}" wx:key="playerId" class="rating-player-row"
          data-player-id="{{item.playerId}}" bindtap="openRatingDialog">
          <view class="rating-player-row__main">
            <view class="rating-player-row__name">{{item.jerseyNo === null ? "" : item.jerseyNo + " "}}{{item.playerName}}</view>
            <view class="rating-player-row__stars">{{item.starsText}}</view>
          </view>
          <view class="rating-player-row__score numeric">{{item.ratingCount === 0 ? "待评分" : item.averageScore + "/10"}}</view>
        </view>
      </view>
      <view class="rating-team-card">
        <view class="rating-team-card__title">{{fixture.awayTeam.name}}</view>
        <view wx:if="{{awayRatings.length === 0}}" class="rating-team-card__empty">暂无出场球员</view>
        <view wx:for="{{awayRatings}}" wx:key="playerId" class="rating-player-row"
          data-player-id="{{item.playerId}}" bindtap="openRatingDialog">
          <view class="rating-player-row__main">
            <view class="rating-player-row__name">{{item.jerseyNo === null ? "" : item.jerseyNo + " "}}{{item.playerName}}</view>
            <view class="rating-player-row__stars">{{item.starsText}}</view>
          </view>
          <view class="rating-player-row__score numeric">{{item.ratingCount === 0 ? "待评分" : item.averageScore + "/10"}}</view>
        </view>
      </view>
    </view>

    <view class="section-head">
      <view class="section-title">比赛事件</view>
      <view class="section-subtitle">按比赛时间排序</view>
    </view>

    <view wx:if="{{eventViews.length === 0}}" class="surface-card">
      <empty-state title="暂无比赛事件" description="比赛事件录入后会在这里展示。" />
    </view>

    <view wx:else class="event-list">
      <view wx:for="{{eventViews}}" wx:key="id" class="event-row">
        <view class="event-row__minute numeric">{{item.minuteLabel}}</view>
        <view class="event-row__marker event-row__marker--{{item.eventTone}}"></view>
        <view class="event-row__body">
          <view class="event-row__headline">
            <t-tag size="small" variant="light" theme="{{item.eventTone}}">{{item.eventLabel}}</t-tag>
            <text class="event-row__team">{{item.teamName}}</text>
          </view>
          <view class="event-row__player">{{item.playerName}}</view>
          <view wx:if="{{item.relatedName}}" class="event-row__assist">助攻：{{item.relatedName}}</view>
          <view wx:if="{{item.note}}" class="event-row__note">{{item.note}}</view>
        </view>
      </view>
    </view>

    <view class="section-head">
      <view class="section-title">出场名单</view>
      <view class="section-subtitle">首发与替补记录</view>
    </view>

    <view class="lineup-grid">
      <view class="lineup-card">
        <view class="lineup-card__title">{{fixture.homeTeam.name}}</view>
        <view wx:if="{{homeAppearances.length === 0}}" class="lineup-card__empty">暂无记录</view>
        <view wx:for="{{homeAppearances}}" wx:key="id" class="lineup-row">
          <view class="lineup-row__name">{{item.playerName}}</view>
          <view class="lineup-row__meta">{{item.starterText}} · {{item.minutesText}}</view>
        </view>
      </view>
      <view class="lineup-card">
        <view class="lineup-card__title">{{fixture.awayTeam.name}}</view>
        <view wx:if="{{awayAppearances.length === 0}}" class="lineup-card__empty">暂无记录</view>
        <view wx:for="{{awayAppearances}}" wx:key="id" class="lineup-row">
          <view class="lineup-row__name">{{item.playerName}}</view>
          <view class="lineup-row__meta">{{item.starterText}} · {{item.minutesText}}</view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{ratingDialogVisible}}" class="rating-overlay" bindtap="closeRatingDialog">
    <view class="rating-sheet" catchtap="noop">
      <view class="rating-sheet__head">
        <view>
          <view class="rating-sheet__title">{{selectedPlayerName}}</view>
          <view class="rating-sheet__meta">{{selectedTeamName}}{{selectedRating ? " · " + (selectedRating.ratingCount ? selectedRating.averageScore + "/10 · " + selectedRating.ratingCount + "人评分" : "暂无评分") : ""}}</view>
        </view>
        <view class="rating-sheet__close" bindtap="closeRatingDialog">×</view>
      </view>

      <scroll-view scroll-y class="rating-sheet__scroll">
        <view class="rating-sheet__label">你的评分</view>
        <star-rating value="{{selectedRatingStars}}" readonly="{{selectedMyRating && !selectedMyRating.canEdit}}"
          bind:change="handleRatingStars" />
        <view class="rating-sheet__score">{{selectedRatingStars ? selectedRatingStars * 2 + " / 10" : "请选择 1–5 星"}}</view>
        <view wx:if="{{selectedRatingStatusText}}" class="rating-sheet__status">{{selectedRatingStatusText}}</view>
        <textarea class="rating-sheet__textarea" value="{{selectedRatingComment}}" maxlength="100"
          bindinput="handleRatingComment" placeholder="可填写 100 字以内评价" />
        <view class="rating-sheet__counter">{{selectedRatingComment.length}}/100</view>
        <t-button theme="primary" block loading="{{ratingSubmitting}}"
          disabled="{{selectedMyRating && !selectedMyRating.canEdit}}" bind:tap="saveRating">提交评分</t-button>

        <view class="rating-comments__head">
          <view>公开评价</view>
          <view>{{selectedRatingComments.length}} 条</view>
        </view>
        <view wx:if="{{selectedRatingComments.length === 0}}" class="rating-comments__empty">暂无公开评价</view>
        <view wx:for="{{selectedRatingComments}}" wx:key="id" class="rating-comment">
          <view class="rating-comment__top">
            <view class="rating-comment__name">{{item.nickname}}</view>
            <view class="rating-comment__score">{{item.score}}/10</view>
          </view>
          <view class="rating-comment__text">{{item.comment}}</view>
          <view class="rating-comment__actions">
            <text>{{item.createdAt}}</text>
            <text data-id="{{item.id}}" catchtap="reportComment">举报</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{refereeDialogVisible}}" class="rating-overlay" bindtap="closeRefereeRatingDialog">
    <view class="rating-sheet referee-rating-sheet" catchtap="noop">
      <view class="rating-sheet__head">
        <view>
          <view class="rating-sheet__title">给主裁评分</view>
          <view class="rating-sheet__meta">{{fixture.referee}}</view>
        </view>
        <view class="rating-sheet__close" bindtap="closeRefereeRatingDialog">×</view>
      </view>
      <view class="rating-sheet__label">你的评分</view>
      <star-rating value="{{refereeStars}}" readonly="{{refereeOwnRating && !refereeOwnRating.canEdit}}"
        bind:change="handleRefereeStars" />
      <view class="rating-sheet__score">{{refereeStars ? refereeStars * 2 + " / 10" : "请选择 1–5 星"}}</view>
      <view class="rating-sheet__status">主裁评分不包含文字评价</view>
      <t-button theme="primary" block loading="{{refereeSubmitting}}"
        disabled="{{refereeOwnRating && !refereeOwnRating.canEdit}}" bind:tap="saveRefereeRating">提交主裁评分</t-button>
    </view>
  </view>

</view>
