.admin-ratings-page { padding-top: 22rpx; }
.center { display: flex; justify-content: center; padding: 100rpx 0; }
.segmented { display: grid; grid-template-columns: 1fr 1fr; padding: 6rpx; margin-top: 18rpx; border-radius: 16rpx; background: #E9E5DA; }
.segmented__item { padding: 16rpx; border-radius: 12rpx; color: #5E6B65; font-size: 24rpx; text-align: center; }
.segmented__item--active { background: #fff; color: #0B6B4B; font-weight: 700; }
.chips { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 18rpx 0; }
.chip { padding: 10rpx 20rpx; border-radius: 999rpx; background: #fff; border: 1rpx solid #E4E2D9; color: #5E6B65; font-size: 21rpx; }
.chip--active { background: #0B6B4B; border-color: #0B6B4B; color: #fff; }
.section-head { margin-top: 24rpx; }
.moderation-list, .term-list { display: flex; flex-direction: column; gap: 12rpx; margin-top: 14rpx; }
.moderation-card, .term-row { padding: 20rpx; border-radius: 18rpx; background: #fff; border: 1rpx solid #E4E2D9; }
.moderation-card__top { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }
.moderation-card__name { font-size: 25rpx; font-weight: 700; }
.moderation-card__meta { margin-top: 8rpx; color: #7C8983; font-size: 20rpx; }
.moderation-card__comment { margin-top: 14rpx; font-size: 23rpx; line-height: 1.6; }
.moderation-card__report { margin-top: 8rpx; color: #C7392F; font-size: 20rpx; }
.moderation-card__actions { display: flex; gap: 10rpx; margin-top: 16rpx; }
.form-card { margin-top: 18rpx; }
.form-title { margin-bottom: 14rpx; font-size: 28rpx; font-weight: 800; }
.form-input, .form-textarea { width: 100%; margin-top: 12rpx; padding: 16rpx; border-radius: 14rpx; background: #F8F6F0; border: 1rpx solid #E4E2D9; box-sizing: border-box; font-size: 24rpx; }
.form-textarea { min-height: 180rpx; }
.term-row { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 16rpx; }
.term-row__main { min-width: 0; }
.term-row__name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 24rpx; font-weight: 700; }
.term-row__meta { margin-top: 5rpx; color: #7C8983; font-size: 20rpx; }
.term-row__action { color: #0B6B4B; font-size: 21rpx; }
.term-row__action--danger { color: #C7392F; }
