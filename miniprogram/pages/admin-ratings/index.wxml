<view class="page-shell admin-ratings-page">
  <app-header title="评分审核" subtitle="审核用户评价与敏感词" season-name="ADMIN" />
  <view wx:if="{{loading}}" class="center"><t-loading theme="circular" size="44rpx" text="加载中" /></view>
  <view wx:elif="{{!verified}}" class="surface-card"><empty-state title="无权限" description="{{error}}" action-text="返回" bind:action="goBack" /></view>
  <block wx:else>
    <view class="segmented">
      <view class="segmented__item {{activeTab === 'ratings' ? 'segmented__item--active' : ''}}" data-tab="ratings" bindtap="switchTab">评价审核</view>
      <view class="segmented__item {{activeTab === 'terms' ? 'segmented__item--active' : ''}}" data-tab="terms" bindtap="switchTab">敏感词</view>
    </view>

    <block wx:if="{{activeTab === 'ratings'}}">
      <view class="chips">
        <view wx:for="{{filters}}" wx:key="value" class="chip {{selectedFilter === item.value ? 'chip--active' : ''}}" data-value="{{item.value}}" bindtap="selectFilter">{{item.label}}</view>
      </view>
      <view class="section-head"><view class="section-title">共 {{total}} 条</view></view>
      <view wx:if="{{items.length === 0}}" class="surface-card"><empty-state title="暂无记录" description="当前筛选下没有需要处理的评价。" /></view>
      <view wx:else class="moderation-list">
        <view wx:for="{{items}}" wx:key="id" class="moderation-card">
          <view class="moderation-card__top">
            <view class="moderation-card__name">{{item.playerName}} · {{item.teamName}}</view>
            <t-tag size="small" variant="light" theme="{{item.status === 'PENDING' ? 'warning' : item.status === 'HIDDEN' ? 'danger' : 'success'}}">{{item.status}}</t-tag>
          </view>
          <view class="moderation-card__meta">{{item.nickname}} · {{item.stars}} 星 · {{item.stars * 2}}/10</view>
          <view class="moderation-card__comment">{{item.comment || "仅评分，无短评"}}</view>
          <view wx:if="{{item.reporterCount}}" class="moderation-card__report">举报 {{item.reporterCount}} 次</view>
          <view class="moderation-card__actions">
            <t-button size="small" theme="success" variant="outline" data-id="{{item.id}}" data-action="approve" bind:tap="moderate">通过</t-button>
            <t-button size="small" theme="danger" variant="outline" data-id="{{item.id}}" data-action="reject" bind:tap="moderate">拒绝</t-button>
            <t-button size="small" theme="default" variant="outline" data-id="{{item.id}}" data-action="hide" bind:tap="moderate">隐藏</t-button>
          </view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="surface-card form-card">
        <view class="form-title">新增敏感词</view>
        <input class="form-input" value="{{termName}}" data-field="termName" bindinput="input" maxlength="64" placeholder="敏感词" />
        <input class="form-input" value="{{termCategory}}" data-field="termCategory" bindinput="input" maxlength="32" placeholder="分类" />
        <view class="chips">
          <view class="chip {{termAction === 'REVIEW' ? 'chip--active' : ''}}" data-field="termAction" data-value="REVIEW" bindtap="selectTermAction">待审核</view>
          <view class="chip {{termAction === 'BLOCK' ? 'chip--active' : ''}}" data-field="termAction" data-value="BLOCK" bindtap="selectTermAction">直接拦截</view>
        </view>
        <t-button theme="primary" block loading="{{busy}}" bind:tap="createTerm">添加敏感词</t-button>
      </view>

      <view class="surface-card form-card">
        <view class="form-title">批量导入</view>
        <textarea class="form-textarea" value="{{importText}}" data-field="importText" bindinput="input" maxlength="20000" placeholder="每行一个敏感词，最多 5000 行" />
        <view class="chips">
          <view class="chip {{importAction === 'REVIEW' ? 'chip--active' : ''}}" data-field="importAction" data-value="REVIEW" bindtap="selectTermAction">待审核</view>
          <view class="chip {{importAction === 'BLOCK' ? 'chip--active' : ''}}" data-field="importAction" data-value="BLOCK" bindtap="selectTermAction">直接拦截</view>
        </view>
        <t-button theme="primary" block loading="{{busy}}" bind:tap="importTerms">批量导入</t-button>
      </view>

      <view class="section-head"><view class="section-title">词库 {{terms.length}} 条</view></view>
      <view wx:if="{{terms.length === 0}}" class="surface-card"><empty-state title="暂无敏感词" description="可添加词条或批量导入。" /></view>
      <view wx:else class="term-list">
        <view wx:for="{{terms}}" wx:key="id" class="term-row">
          <view class="term-row__main">
            <view class="term-row__name">{{item.term}}</view>
            <view class="term-row__meta">{{item.category}} · {{item.action === 'BLOCK' ? '拦截' : '审核'}} · {{item.enabled ? '启用' : '停用'}}</view>
          </view>
          <view class="term-row__action" data-id="{{item.id}}" bindtap="toggleTerm">{{item.enabled ? '停用' : '启用'}}</view>
          <view class="term-row__action term-row__action--danger" data-id="{{item.id}}" bindtap="removeTerm">删除</view>
        </view>
      </view>
    </block>
  </block>
</view>
