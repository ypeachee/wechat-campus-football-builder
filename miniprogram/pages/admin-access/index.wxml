<view class="page-shell admin-access-page">
  <app-header title="球队授权" subtitle="按球队授予授权管理员或领队" season-name="ADMIN" />

  <view wx:if="{{loading}}" class="admin-loading">
    <t-loading theme="circular" size="44rpx" text="加载授权信息" />
  </view>

  <view wx:elif="{{!verified}}" class="surface-card">
    <empty-state title="无权限" description="{{error}}" action-text="返回" bind:action="goBack" />
  </view>

  <block wx:else>
    <scroll-view class="team-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="team-tabs">
        <view
          wx:for="{{teams}}"
          wx:key="id"
          class="team-tab {{selectedTeamId === item.id ? 'team-tab--active' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectTeam"
        >{{item.name}}</view>
      </view>
    </scroll-view>

    <view wx:if="{{selectedTeam}}" class="surface-card access-card">
      <view class="access-card__title">{{selectedTeam.name}}</view>
      <view class="access-card__copy">当前授权用户</view>
      <view wx:if="{{managers.length === 0}}" class="manager-empty">暂无授权用户</view>
      <view wx:else class="manager-list">
        <view wx:for="{{managers}}" wx:key="userId" class="manager-row">
          <view class="manager-row__main">
            <view class="manager-row__id numeric">#{{item.userId}}</view>
            <view class="manager-row__role">{{item.roleText}}</view>
          </view>
          <view class="manager-row__revoke" data-id="{{item.userId}}" bindtap="revokeManager">撤销</view>
        </view>
      </view>

      <view class="grant-section">
        <view class="form-label">搜索用户</view>
        <view class="user-search-row">
          <input class="grant-input" value="{{userQuery}}" bindinput="handleUserQueryInput"
            bindconfirm="searchUsers" confirm-type="search" placeholder="输入用户 ID 或昵称" />
          <t-button theme="default" size="small" variant="outline" loading="{{userSearching}}" bind:tap="searchUsers">搜索</t-button>
        </view>
        <view wx:if="{{userResults.length > 0}}" class="user-search-results">
          <view wx:for="{{userResults}}" wx:key="id" class="user-search-item"
            data-id="{{item.id}}" bindtap="selectUser">
            <view>
              <view class="user-search-item__name">{{item.nickname || "未设置昵称"}}</view>
              <view class="user-search-item__meta">ID {{item.id}} · {{item.roleText}}</view>
            </view>
            <text class="user-search-item__select">选择</text>
          </view>
        </view>

        <view class="form-label">授权类型</view>
        <view class="grant-role-row">
          <view
            wx:for="{{grantRoleOptions}}"
            wx:key="value"
            class="grant-role {{grantRole === item.value ? 'grant-role--active' : ''}}"
            data-value="{{item.value}}"
            bindtap="selectGrantRole"
          >{{item.label}}</view>
        </view>
        <view class="form-label">授权用户</view>
        <view class="grant-row">
          <input class="grant-input" type="number" value="{{grantUserId}}" bindinput="handleUserIdInput" placeholder="输入用户 ID" />
          <t-button theme="primary" size="small" loading="{{submitting}}" bind:tap="grantManager">授权</t-button>
        </view>
        <view class="grant-hint">可搜索用户 ID 或昵称，也可以手动输入用户 ID。授权管理员可管理全部数据；领队只能维护本队人员和本队阵容。</view>
      </view>
    </view>
  </block>
</view>