.home-page {
  padding-top: 22rpx;
}

.home-loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.home-error {
  margin-top: 24rpx;
}

.home-error__title {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.home-error__action {
  margin-top: 24rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 38rpx;
}

.section-head .section-title {
  margin: 0;
}

.text-link {
  flex-shrink: 0;
  color: #0B6B4B;
  font-size: 23rpx;
  font-weight: 600;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 20rpx;
}

.quick-card {
  min-height: 150rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid #E4E2D9;
  box-sizing: border-box;
}

.quick-card--green {
  background: #E4F5EC;
  border-color: #CDE9DA;
}

.quick-card__index {
  color: #7C8983;
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.quick-card__title {
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.quick-card__copy {
  margin-top: 6rpx;
  color: #5E6B65;
  font-size: 20rpx;
  line-height: 1.4;
}
