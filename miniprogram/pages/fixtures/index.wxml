<view class="page-shell fixtures-page">
  <app-header title="赛程中心" subtitle="按赛事、阶段和小组查看比赛" season-name="FIXTURES" />
  <view class="hierarchy-card">
    <picker mode="selector" range="{{competitions}}" range-key="name" bindchange="handleCompetitionChange">
      <view class="hierarchy-row"><text class="hierarchy-label">赛事</text><text class="hierarchy-value">{{selectedCompetitionName || "选择赛事"}}</text></view>
    </picker>
    <picker mode="selector" range="{{seasons}}" range-key="name" bindchange="handleSeasonChange">
      <view class="hierarchy-row"><text class="hierarchy-label">赛季</text><text class="hierarchy-value">{{selectedSeasonName || "选择赛季"}}</text></view>
    </picker>
    <picker mode="selector" range="{{stages}}" range-key="name" bindchange="handleStageChange">
      <view class="hierarchy-row"><text class="hierarchy-label">阶段</text><text class="hierarchy-value">{{selectedStageName || "选择阶段"}}</text></view>
    </picker>
    <picker wx:if="{{groups.length > 0}}" mode="selector" range="{{groups}}" range-key="name" bindchange="handleGroupChange">
      <view class="hierarchy-row"><text class="hierarchy-label">小组</text><text class="hierarchy-value">{{selectedGroupName || "选择小组"}}</text></view>
    </picker>
    <view wx:if="{{canOpenBracket}}" class="hierarchy-row hierarchy-row--action" bindtap="openBracket">
      <text class="hierarchy-label">淘汰赛</text><text class="hierarchy-value">查看决赛树 ›</text>
    </view>
  </view>

  <scroll-view class="status-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="status-chips">
      <view
        wx:for="{{statusFilters}}"
        wx:key="value"
        class="status-chip {{selectedStatus === item.value ? 'status-chip--active' : ''}}"
        data-value="{{item.value}}"
        bindtap="handleStatusFilter"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="fixtures-loading">
    <t-loading theme="circular" size="48rpx" text="加载赛程" />
  </view>

  <view wx:elif="{{error}}" class="surface-card">
    <empty-state title="赛程加载失败" description="{{error}}" action-text="重试" bind:action="retry" />
  </view>

  <view wx:elif="{{filteredFixtures.length === 0}}" class="surface-card">
    <empty-state title="暂无比赛" description="当前筛选条件下没有可展示的比赛。" />
  </view>

  <view wx:else class="fixture-list">
    <match-card
      wx:for="{{filteredFixtures}}"
      wx:key="id"
      match="{{item}}"
      bind:select="openFixture"
    />
  </view>
</view>
