.admin-fixtures-page {
  padding-top: 22rpx;
}

.admin-loading {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
}

.season-scroll {
  margin-top: 20rpx;
  white-space: nowrap;
}

.season-tabs {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 24rpx;
}

.season-tab {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid #E4E2D9;
  color: #5E6B65;
  font-size: 23rpx;
}

.season-tab--active {
  background: #0B6B4B;
  border-color: #0B6B4B;
  color: #FFFFFF;
  font-weight: 600;
}

.create-card {
  margin-top: 18rpx;
}

.create-card__title {
  font-size: 30rpx;
  font-weight: 800;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.form-field {
  margin-top: 16rpx;
}

.form-label {
  margin-bottom: 8rpx;
  color: #5E6B65;
  font-size: 21rpx;
}

.form-input,
.picker-value {
  height: 72rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  border-radius: 14rpx;
  background: #F8F6F0;
  border: 1rpx solid #E4E2D9;
  box-sizing: border-box;
  font-size: 24rpx;
}

.form-actions {
  margin-top: 22rpx;
}

.section-head {
  margin-top: 32rpx;
}

.section-head .section-title {
  margin: 0;
}

.fixture-admin-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 16rpx;
}

.fixture-admin-card {
  padding: 22rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid #E4E2D9;
}

.fixture-admin-card__top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.fixture-admin-card__time {
  flex: 1;
  color: #7C8983;
  font-size: 21rpx;
}

.fixture-admin-card__teams {
  display: grid;
  grid-template-columns: 1fr 140rpx 1fr;
  align-items: center;
  gap: 10rpx;
  margin: 20rpx 0;
  font-size: 26rpx;
  font-weight: 700;
}

.fixture-admin-card__score {
  color: #0B6B4B;
  font-size: 32rpx;
  text-align: center;
}

.fixture-admin-card__away {
  text-align: right;
}

.fixture-admin-card__meta {
  margin: -8rpx 0 16rpx;
  color: #7C8983;
  font-size: 21rpx;
}

.fixture-admin-card__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EEECE5;
}

.score-dialog {
  padding: 30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 26rpx 26rpx 0 0;
  background: #FFFFFF;
}

.score-dialog__title {
  font-size: 32rpx;
  font-weight: 800;
}

.score-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.score-dialog__actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 28rpx;
}
