.manage-page {
  padding-top: 22rpx;
}

.manage-loading {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
}

.admin-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 22rpx;
}

.admin-card {
  padding: 22rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid #E4E2D9;
}

.admin-card__index {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #E4F5EC;
  color: #0B6B4B;
  font-size: 20rpx;
  font-weight: 800;
}

.admin-card__title {
  margin-top: 18rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.admin-card__copy {
  margin-top: 5rpx;
  color: #7C8983;
  font-size: 20rpx;
  line-height: 1.5;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 34rpx;
}

.section-head .section-title {
  margin: 0;
}

.text-button {
  color: #0B6B4B;
  font-size: 23rpx;
  font-weight: 700;
}

.team-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.manager-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 22rpx;
}


.rating-admin-overlay { position: fixed; z-index: 60; inset: 0; display: flex; align-items: flex-end; background: rgba(0,0,0,.45); }
.rating-admin-panel { width: 100%; height: 84vh; padding: 24rpx; border-radius: 28rpx 28rpx 0 0; background: #F4F1E8; box-sizing: border-box; }
.rating-admin-head { display: flex; align-items: center; justify-content: space-between; }
.rating-admin-title { font-size: 32rpx; font-weight: 800; }
.rating-admin-close { color: #7C8983; font-size: 44rpx; }
.rating-admin-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 8rpx; margin-top: 16rpx; padding: 6rpx; border-radius: 14rpx; background: #E9E5DA; }
.rating-admin-tab { padding: 14rpx; border-radius: 10rpx; text-align: center; font-size: 23rpx; color: #5E6B65; }
.rating-admin-tab--active { background: #fff; color: #0B6B4B; font-weight: 700; }
.rating-admin-scroll { height: calc(84vh - 150rpx); margin-top: 16rpx; }
.rating-admin-chips { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 14rpx; }
.rating-admin-chip { padding: 10rpx 20rpx; border-radius: 999rpx; background: #fff; border: 1rpx solid #E4E2D9; color: #5E6B65; font-size: 21rpx; }
.rating-admin-chip--active { background: #0B6B4B; border-color: #0B6B4B; color: #fff; }
.rating-admin-count { margin: 12rpx 0; color: #5E6B65; font-size: 22rpx; font-weight: 700; }
.rating-admin-empty { padding: 50rpx 0; color: #7C8983; font-size: 22rpx; text-align: center; }
.rating-admin-card, .rating-admin-form, .rating-admin-term { margin-bottom: 12rpx; padding: 20rpx; border-radius: 18rpx; background: #fff; border: 1rpx solid #E4E2D9; }
.rating-admin-card__top { display: flex; justify-content: space-between; font-size: 24rpx; font-weight: 700; }
.rating-admin-card__meta { margin-top: 8rpx; color: #7C8983; font-size: 20rpx; }
.rating-admin-card__comment { margin-top: 12rpx; font-size: 23rpx; line-height: 1.6; }
.rating-admin-card__report { margin-top: 8rpx; color: #C7392F; font-size: 20rpx; }
.rating-admin-actions { display: flex; gap: 10rpx; margin-top: 14rpx; }
.rating-admin-input, .rating-admin-textarea { width: 100%; margin-bottom: 12rpx; padding: 16rpx; border-radius: 12rpx; background: #F8F6F0; border: 1rpx solid #E4E2D9; box-sizing: border-box; font-size: 23rpx; }
.rating-admin-textarea { min-height: 150rpx; }
.rating-admin-term { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 14rpx; }
.rating-admin-term__main { min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.rating-admin-term__main text:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 700; }
.rating-admin-term__main text:last-child { color: #7C8983; font-size: 19rpx; }
.rating-admin-link { color: #0B6B4B; font-size: 21rpx; }
.rating-admin-link--danger { color: #C7392F; }

.todo-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12rpx; margin-bottom: 18rpx; }
.todo-card { padding: 20rpx; border-radius: 18rpx; background: #E8F2ED; border: 1rpx solid #C9E2D6; }
.todo-card--rating { background: #EEF3FF; border-color: #D4DEFA; }
.todo-card--report { background: #FFF3E7; border-color: #F4D7B7; }
.todo-card--suspension { background: #FFF0EE; border-color: #F1CFCB; }
.todo-card__number { color: #0B6B4B; font-size: 40rpx; font-weight: 850; }
.todo-card--report .todo-card__number, .todo-card--suspension .todo-card__number { color: #A34600; }
.todo-card__label { margin-top: 4rpx; color: #5E6B65; font-size: 21rpx; }