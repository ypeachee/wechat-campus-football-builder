.manage-page {
  padding-top: 22rpx;
}

.manage-loading {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
}

.admin-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 22rpx;
}

.admin-card {
  padding: 22rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid #E4E2D9;
}

.admin-card__index {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #E4F5EC;
  color: #0B6B4B;
  font-size: 20rpx;
  font-weight: 800;
}

.admin-card__title {
  margin-top: 18rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.admin-card__copy {
  margin-top: 5rpx;
  color: #7C8983;
  font-size: 20rpx;
  line-height: 1.5;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 34rpx;
}

.section-head .section-title {
  margin: 0;
}

.text-button {
  color: #0B6B4B;
  font-size: 23rpx;
  font-weight: 700;
}

.team-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}
