.player-detail-page {
  padding-top: 22rpx;
}

.detail-loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.player-profile {
  margin-top: 22rpx;
}

.player-profile__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EEECE5;
}

.player-profile__row:last-child {
  border-bottom: 0;
}

.player-profile__label {
  color: #7C8983;
  font-size: 23rpx;
}

.player-profile__value {
  font-size: 25rpx;
  font-weight: 600;
}

.player-tip {
  margin-top: 18rpx;
  color: #5E6B65;
  font-size: 23rpx;
  line-height: 1.7;
}
