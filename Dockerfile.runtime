FROM eclipse-temurin:21-jre-alpine
RUN apk add --no-cache curl tzdata \
    && addgroup -S app \
    && adduser -S app -G app
WORKDIR /app
COPY campus-football.jar /app/app.jar
USER app
EXPOSE 8080
ENV JAVA_OPTS="-Xms128m -Xmx1024m -XX:MaxMetaspaceSize=256m -XX:ReservedCodeCacheSize=96m -XX:MaxDirectMemorySize=64m -XX:+UseG1GC -XX:ActiveProcessorCount=2 -Xss512k -Djava.security.egd=file:/dev/urandom"
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
