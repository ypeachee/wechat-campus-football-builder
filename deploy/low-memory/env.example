# This server is too small to host MySQL. Use an external MySQL instance.
# Example JDBC URL for an external MySQL provider:
# jdbc:mysql://HOST:PORT/DB_NAME?sslMode=REQUIRED&serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf8
DB_URL=replace-with-external-mysql-jdbc-url
DB_USERNAME=replace-with-external-mysql-user
DB_PASSWORD=replace-with-external-mysql-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL=PT2H
WECHAT_APP_ID=replace-with-your-mini-program-app-id
WECHAT_APP_SECRET=replace-with-your-mini-program-app-secret
ADMIN_WECHAT_OPENID=replace-with-the-first-admin-openid
SERVER_PORT=8080