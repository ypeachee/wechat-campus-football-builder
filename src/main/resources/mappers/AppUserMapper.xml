<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campusfootball.user.AppUserMapper">
    <resultMap id="AppUserMap" type="com.campusfootball.user.AppUser">
        <id property="id" column="id"/>
        <result property="wechatOpenid" column="wechat_openid"/>
        <result property="unionid" column="unionid"/>
        <result property="nickname" column="nickname"/>
        <result property="avatarUrl" column="avatar_url"/>
        <result property="roleCode" column="role_code"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByOpenId" resultMap="AppUserMap">
        SELECT * FROM app_user WHERE wechat_openid = #{openid}
    </select>

    <select id="findById" resultMap="AppUserMap">
        SELECT * FROM app_user WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO app_user (wechat_openid, unionid, nickname, avatar_url, role_code, status)
        VALUES (#{wechatOpenid}, #{unionid}, #{nickname}, #{avatarUrl}, #{roleCode}, #{status})
    </insert>

    <update id="updateRole">
        UPDATE app_user SET role_code = #{role}, updated_at = CURRENT_TIMESTAMP WHERE id = #{id}
    </update>

    <update id="updateProfile">
        UPDATE app_user
        <set>
            <if test="unionid != null">unionid = #{unionid},</if>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="avatarUrl != null">avatar_url = #{avatarUrl},</if>
            updated_at = CURRENT_TIMESTAMP
        </set>
        WHERE id = #{id}
    </update>
</mapper>
