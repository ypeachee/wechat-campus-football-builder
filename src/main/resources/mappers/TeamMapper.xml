<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campusfootball.team.TeamMapper">
    <resultMap id="TeamMap" type="com.campusfootball.team.Team">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="shortName" column="short_name"/>
        <result property="logoUrl" column="logo_url"/>
        <result property="coachName" column="coach_name"/>
        <result property="homeVenue" column="home_venue"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findActive" resultMap="TeamMap">
        SELECT * FROM team WHERE status = 'ACTIVE' ORDER BY name
    </select>

    <select id="findAll" resultMap="TeamMap">
        SELECT * FROM team ORDER BY name
    </select>

    <select id="findById" resultMap="TeamMap">
        SELECT * FROM team WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO team (name, short_name, logo_url, coach_name, home_venue, status)
        VALUES (#{name}, #{shortName}, #{logoUrl}, #{coachName}, #{homeVenue}, #{status})
    </insert>

    <update id="update">
        UPDATE team
        SET name = #{name},
            short_name = #{shortName},
            logo_url = #{logoUrl},
            coach_name = #{coachName},
            home_venue = #{homeVenue},
            status = #{status},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>
</mapper>
