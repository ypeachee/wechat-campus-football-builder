<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campusfootball.rating.SensitiveTermMapper">
    <resultMap id="SensitiveTermMap" type="com.campusfootball.rating.SensitiveTerm">
        <id property="id" column="id"/>
        <result property="term" column="term"/>
        <result property="category" column="category"/>
        <result property="action" column="action"/>
        <result property="enabled" column="enabled"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findAll" resultMap="SensitiveTermMap">
        SELECT * FROM sensitive_term ORDER BY updated_at DESC, id DESC
    </select>
    <select id="findEnabled" resultMap="SensitiveTermMap">
        SELECT * FROM sensitive_term WHERE enabled = 1 ORDER BY id
    </select>
    <select id="findById" resultMap="SensitiveTermMap">
        SELECT * FROM sensitive_term WHERE id = #{id}
    </select>
    <select id="findByTerm" resultMap="SensitiveTermMap">
        SELECT * FROM sensitive_term WHERE term = #{term} LIMIT 1
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sensitive_term (term, category, action, enabled, created_by)
        VALUES (#{term}, #{category}, #{action}, #{enabled}, #{createdBy})
    </insert>
    <update id="update">
        UPDATE sensitive_term
        SET category = #{category}, action = #{action}, enabled = #{enabled}, updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>
    <delete id="delete">
        DELETE FROM sensitive_term WHERE id = #{id}
    </delete>
</mapper>
