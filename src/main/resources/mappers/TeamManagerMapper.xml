<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campusfootball.team.TeamManagerMapper">
    <select id="findTeamIdsByUserId" resultType="long">
        SELECT team_id FROM team_manager WHERE user_id = #{userId} ORDER BY team_id
    </select>
</mapper>
