# Copy this file to .env.production on the server and replace every value.
API_DOMAIN=api.cugbsoccer.xyz
MYSQL_DATABASE=campus_football
MYSQL_USER=campus
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL=PT168H
WECHAT_APP_ID=replace-with-your-mini-program-app-id
WECHAT_APP_SECRET=replace-with-your-mini-program-app-secret
WECHAT_CODE_ENV_VERSION=release
ADMIN_WECHAT_OPENID=replace-with-the-first-admin-openid
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=replace-with-a-strong-web-admin-password
# Set to true only when you need to reset the web admin password at next startup.
# After resetting, set it back to false to avoid overwriting the password on every restart.
WEB_ADMIN_RESET_PASSWORD=false
# Set to true only when the API is exposed exclusively through a trusted reverse proxy (Caddy/Nginx).
# The compose.prod.yaml defaults this to true because Caddy is the only public entry point.
# If you expose the API port 8080 directly to the internet, set this to false to prevent XFF spoofing.
TRUST_FORWARDED_HEADERS=true
# Tuned for a 2 GiB server with 2 GiB Swap. Keep container limits aligned.
JAVA_OPTS=-Xms128m -Xmx512m -XX:MaxMetaspaceSize=160m -XX:ReservedCodeCacheSize=48m -XX:MaxDirectMemorySize=32m -XX:+UseSerialGC -XX:ActiveProcessorCount=2 -Xss512k -Duser.timezone=Asia/Shanghai -Djava.security.egd=file:/dev/urandom
# Optional Aliyun OSS target for daily database backups.
OSS_BACKUP_URI=
# Optional DingTalk/WeCom-compatible webhook used by health-check.sh alerts.
ALERT_WEBHOOK_URL=

