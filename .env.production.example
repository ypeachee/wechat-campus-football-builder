# Copy this file to .env.production on the server and replace every value.
API_DOMAIN=api.cugbsoccer.xyz
MYSQL_DATABASE=campus_football
MYSQL_USER=campus
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL=PT2H
WECHAT_APP_ID=replace-with-your-mini-program-app-id
WECHAT_APP_SECRET=replace-with-your-mini-program-app-secret
ADMIN_WECHAT_OPENID=replace-with-the-first-admin-openid
# Use these defaults on a 2 GB server. Set -Xmx768m when the server has 4 GB.
JAVA_OPTS=-Xms128m -Xmx512m -XX:+UseG1GC
# Optional Aliyun OSS target for daily database backups.
OSS_BACKUP_URI=
# Optional DingTalk/WeCom-compatible webhook used by health-check.sh alerts.
ALERT_WEBHOOK_URL=
